# =============================================================
#  .gitignore - repositorio del TFG (IHTC 2024)
#
#  Politica de versionado:
#   - SI se versiona: codigo fuente, resultados PROCESADOS y sus CSV,
#     figuras y documentacion de la memoria.
#   - NO se versiona: datos de terceros (instancias, validador y
#     soluciones oficiales de la competicion) -> se REFERENCIAN en el
#     README; ni las salidas INTERMEDIAS, que se regeneran ejecutando
#     los scripts.
# =============================================================

# --- Entorno de Python -------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
.ipynb_checkpoints/

# --- Datos de terceros: se REFERENCIAN, no se suben (ver README) ---
# instancias oficiales IHTC 2024
instancias/
instances/
# soluciones publicadas por la competicion
soluciones_oficiales/
# instancias de prueba usadas en desarrollo
test*.json
data/*
!data/.gitkeep

# --- Validador oficial: se referencia, no se sube (ver README) ---
IHTP_Validator.cc
IHTP_Validator.exe
json.hpp
validador
*.exe
*.dll

# --- Resultados INTERMEDIOS (se regeneran al ejecutar): NO se suben ---
resultados/
resultados_rapido/
resultados_competicion/
resultados_competicion_ihtc/
results/*
!results/.gitkeep

# --- Diagnosticos: solo se suben los CSV (la fuente de los datos) ---
diagnostico_admisiones/*
!diagnostico_admisiones/*.csv
diagnostico_cirujanos_opcionales/*
!diagnostico_cirujanos_opcionales/*.csv

# --- Salidas sueltas de desarrollo en la raiz --------------
solucion_*.json
mejor_solucion*.json
estadisticas_*.json
feedback_*.json
validator_*.json
*.log
*.lp
*.ilp
*.mps
*.sol

# --- Copias/versiones antiguas y temporales de edicion -----
# copias stale; el codigo vive en la raiz
src/
diagnosticos/
*.bak
*.bak_pre_fix
*_backup.py
Nuevo Documento de texto.txt
_tfg_texto.txt
Analisis_implementacion_TFG.docx

# --- Scripts auxiliares NO documentados en el README -------
# generadores de informes .docx, orquestadores de experimentos y la app Dash;
# se conservan en local pero no forman parte de la estructura del repositorio.
ablacion_tabla_docx.py
comparacion_memoria_docx.py
comparacion_vs_competicion_docx.py
comparar_resultados_oficiales.py
app_dashboard_tfg.py
ejecutar_experimentos_ihtc.py
ejecutar_experimentos_ihtc_competicion.py
experimentos_pipeline_completo.py
experimentos_semillas_fase3.py
ejecutar_ablacion_sin_readmision.py
regenerar_informe.py

# --- Configuracion local de herramientas -------------------
.claude/

# --- Articulos / bibliografia (pesados, no son codigo) -----
artículos/

# --- Sistema -----------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
